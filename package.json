{
  "name": "cvcfontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.0",
  "scripts": {
    "dev": "concurrently -k \"npm:api\" \"npm:frontend\"",
    "start": "npm run dev",
    "frontend": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api": "node server/index.mjs"
  },
  "dependencies": {
    "@amcharts/amcharts5": "^5.19.1",
    "@amcharts/amcharts5-geodata": "^5.1.5",
    "@angular/animations": "^21.2.8",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@awesome.me/webawesome": "^3.8.0",
    "@fullcalendar/angular": "^6.1.21",
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/timegrid": "^6.1.21",
    "@popperjs/core": "^2.11.8",
    "@tailwindcss/postcss": "^4.3.1",
    "apexcharts": "^5.15.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "flatpickr": "^4.6.13",
    "ng-apexcharts": "^2.4.0",
    "ng-otp-input": "^2.0.10",
    "prismjs": "^1.30.0",
    "rxjs": "~7.8.0",
    "swiper": "^12.2.0",
    "tailwindcss": "^4.3.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.3",
    "@angular/cli": "^21.2.7",
    "@angular/compiler-cli": "^21.2.0",
    "concurrently": "^9.2.1",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
